# Copy to .env and fill in. .env is gitignored; this template is not.

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.../).
# Falls back to a local in-memory store if unreachable at startup.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# Optional: override the database name (default: priorityai)
# MONGODB_DB="priorityai"

# JWT signing secret for /auth/login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: token lifetime in minutes (default: 720)
# PRIORITYAI_JWT_EXPIRE_MINUTES="720"
